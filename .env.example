# ============================================================
# AM VISUAL STUDIO — Portfolio Website Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Next.js Public env (safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- Supabase Service Role (server-side ONLY, never in browser) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Site configuration ---
NEXT_PUBLIC_SITE_URL=https://amvisualstudio.com
NEXT_PUBLIC_WHATSAPP_NUMBER=9665XXXXXXXX
NEXT_PUBLIC_INSTAGRAM=https://instagram.com/yourhandle
NEXT_PUBLIC_YOUTUBE=https://youtube.com/@yourchannel
NEXT_PUBLIC_LINKEDIN=https://linkedin.com/in/yourprofile
NEXT_PUBLIC_EMAIL=hello@amvisualstudio.com

# --- Admin credentials (email + password used for the admin login) ---
ADMIN_EMAIL=your.admin@email.com
ADMIN_PASSWORD=your-strong-admin-password

# --- Optional: Resend email API key for contact form ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx